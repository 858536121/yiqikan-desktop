{
  "name": "yiqikan",
  "version": "1.16.0",
  "private": true,
  "packageManager": "pnpm@9.12.2",
  "scripts": {
    "build": "pnpm -r build",
    "desktop": "pnpm --filter @yiqikan/desktop dev",
    "mobile": "pnpm --filter mobile start",
    "ws": "pnpm --filter @yiqikan/server dev",
    "web": "pnpm --filter @yiqikan/web dev",
    "deploy": "bash ./deploy.sh",
    "deploy:remote": "git push && ssh ubuntu@124.221.252.171 'cd /home/ubuntu/yiqikan && bash deploy.sh'",
    "deploy:remote:status": "ssh ubuntu@124.221.252.171 'pm2 status'",
    "deploy:remote:logs": "ssh ubuntu@124.221.252.171 'pm2 logs'",
    "deploy:web": "bash ./deploy.sh --web",
    "deploy:server": "bash ./deploy.sh --server",
    "deploy:all": "bash ./deploy.sh --all",
    "deploy:force": "bash ./deploy.sh --force",
    "deploy:status": "pm2 status yiqikan-server yiqikan-web",
    "deploy:logs": "pm2 logs yiqikan-server yiqikan-web",
    "deploy:stop": "pm2 stop yiqikan-server yiqikan-web",
    "db:generate": "corepack pnpm --filter @yiqikan/web db:generate",
    "db:migrate": "corepack pnpm --filter @yiqikan/web db:migrate",
    "db:migrate:deploy": "corepack pnpm --filter @yiqikan/web db:migrate:deploy",
    "db:push": "corepack pnpm --filter @yiqikan/web db:push",
    "db:seed": "corepack pnpm --filter @yiqikan/web db:seed",
    "sync-release-config": "corepack pnpm --filter @yiqikan/web sync-release-config",
    "db:studio": "corepack pnpm --filter @yiqikan/web db:studio",
    "db:up": "docker compose --env-file .env.db -f docker-compose.db.yml up -d postgres redis",
    "db:down": "docker compose --env-file .env.db -f docker-compose.db.yml down",
    "db:logs": "docker compose --env-file .env.db -f docker-compose.db.yml logs -f",
    "dist": "pnpm --filter @yiqikan/desktop dist",
    "dist:mac": "pnpm --filter @yiqikan/desktop dist:mac",
    "dist:win": "pnpm --filter @yiqikan/desktop dist:win",
    "pub": "bash scripts/publish.sh all",
    "publish": "bash scripts/publish.sh all",
    "publish:all": "bash scripts/publish.sh all",
    "publish:desktop": "bash scripts/publish.sh desktop",
    "publish:mobile": "bash scripts/publish.sh mobile",
    "publish:extension": "bash scripts/publish.sh extension",
    "release:mobile": "bash scripts/release-mobile.sh",
    "release:renderer": "bash scripts/release-renderer.sh",
    "release": "bash scripts/release.sh",
    "dist:linux": "pnpm --filter @yiqikan/desktop dist:linux",
    "lint": "pnpm -r lint",
    "test:server": "pnpm --filter @yiqikan/server test",
    "test:mobile:e2e": "pnpm --filter mobile test:e2e:dual",
    "typecheck": "pnpm -r typecheck"
  },
  "devDependencies": {
    "pm2": "^5.4.3"
  }
}
