{
  "expo": {
    "name": "异起看",
    "slug": "yiqikan-mobile",
    "version": "1.28.0",
    "runtimeVersion": "1.28.0",
    "updates": {
      "enabled": true,
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0,
      "url": "https://yiqikan.club/api/updates/manifest"
    },
    "scheme": "yiqikan",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0D0E12"
    },
    "ios": {
      "icon": "./assets/ios-icon.png",
      "bundleIdentifier": "com.yiqikan.app",
      "supportsTablet": true,
      "infoPlist": {
        "NSMicrophoneUsageDescription": "异起看需要访问您的麦克风以进行房间内实时语音通话。",
        "ITSAppUsesNonExemptEncryption": false,
        "UIBackgroundModes": [
          "audio"
        ],
        "NSPhotoLibraryUsageDescription": "选择照片作为头像，仅在确认保存资料后上传并展示给房间成员。"
      }
    },
    "android": {
      "package": "com.yiqikan.app",
      "versionCode": 6,
      "usesCleartextTraffic": true,
      "adaptiveIcon": {
        "backgroundColor": "#0D0E12",
        "foregroundImage": "./assets/android-icon-foreground.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "RECORD_AUDIO",
        "MODIFY_AUDIO_SETTINGS",
        "FOREGROUND_SERVICE",
        "FOREGROUND_SERVICE_MICROPHONE",
        "FOREGROUND_SERVICE_MEDIA_PLAYBACK",
        "WAKE_LOCK"
      ],
      "blockedPermissions": [
        "android.permission.CAMERA"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "./plugins/withAudioMixing",
      "./plugins/withPlayerDevice",
      "./plugins/withDeviceAuth",
      [
        "expo-image-picker",
        {
          "photosPermission": "选择照片作为头像，仅在确认保存资料后上传并展示给房间成员。",
          "colors": {
            "cropToolbarColor": "#111214",
            "cropToolbarIconColor": "#f0efeb",
            "cropToolbarActionTextColor": "#fb923c",
            "cropBackgroundColor": "#111214",
            "cropBackButtonIconColor": "#f0efeb"
          },
          "dark": {
            "colors": {
              "cropToolbarColor": "#111214",
              "cropToolbarIconColor": "#f0efeb",
              "cropToolbarActionTextColor": "#fb923c",
              "cropBackgroundColor": "#111214",
              "cropBackButtonIconColor": "#f0efeb"
            }
          }
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "b6ff7507-925a-470f-ba53-2ad9ff812e46"
      }
    }
  }
}
