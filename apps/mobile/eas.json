{
  "cli": {
    "version": ">= 12.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal"
    },
    "preview": {
      "distribution": "internal"
    },
    "ios-pip-qa": {
      "extends": "production",
      "distribution": "store",
      "environment": "production",
      "pnpm": "9.12.2",
      "ios": {
        "image": "sdk-57"
      },
      "env": {
        "YIQIKAN_PIP_QA_VERSION": "1.36.3",
        "SHARP_IGNORE_GLOBAL_LIBVIPS": "1"
      }
    },
    "production": {
      "autoIncrement": true,
      "env": {
        "EXPO_PUBLIC_NATIVE_VOICE_ENABLED": "true",
        "EXPO_USE_PRECOMPILED_MODULES": "0"
      }
    }
  },
  "submit": {
    "ios-pip-qa": {
      "ios": {
        "ascAppId": "6817970332"
      }
    },
    "production": {}
  }
}
