{
  "name": "@yiqikan/desktop",
  "version": "1.18.0",
  "private": true,
  "description": "Yiqikan desktop app for synchronized long-distance video watching.",
  "author": "Yiqikan",
  "type": "module",
  "main": "out/main/index.js",
  "scripts": {
    "build": "electron-vite build",
    "dev": "electron-vite dev",
    "pack": "electron-vite build && electron-builder --dir",
    "dist": "electron-vite build && electron-builder",
    "dist:mac": "electron-vite build && electron-builder --mac",
    "dist:win": "electron-vite build && electron-builder --win --x64",
    "dist:win:arm64": "electron-vite build && electron-builder --win --arm64",
    "dist:win:all": "electron-vite build && electron-builder --win --x64 --arm64",
    "dist:linux": "electron-vite build && electron-builder --linux",
    "lint": "tsc -p tsconfig.json --noEmit",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "build": {
    "appId": "com.yiqikan.desktop",
    "productName": "异起看",
    "directories": {
      "output": "release"
    },
    "files": [
      "out/**/*",
      "!out/main/dev-inspector*"
    ],
    "extraResources": [
      {
        "from": "../browser-extension",
        "to": "extension",
        "filter": [
          "**/*",
          "!node_modules/**"
        ]
      }
    ],
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "artifactName": "Yiqikan ${version} ${arch}.${ext}",
      "category": "public.app-category.entertainment",
      "icon": "build/icon.icns",
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.inherit.plist",
      "extendInfo": {
        "NSMicrophoneUsageDescription": "异起看需要访问您的麦克风以支持房间内语音通话"
      }
    },
    "afterPack": "./afterPack.cjs",
    "dmg": {
      "background": "build/dmg-background.png",
      "window": {
        "width": 640,
        "height": 430
      },
      "contents": [
        {
          "x": 155,
          "y": 145,
          "type": "file"
        },
        {
          "x": 460,
          "y": 145,
          "type": "link",
          "path": "/Applications"
        },
        {
          "x": 305,
          "y": 345,
          "type": "file",
          "path": "build/安装指南.html"
        }
      ]
    },
    "win": {
      "target": [
        {
          "target": "nsis"
        },
        {
          "target": "portable"
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "异起看",
      "artifactName": "Yiqikan Setup ${version}.${ext}"
    },
    "portable": {
      "artifactName": "Yiqikan ${version} portable.${ext}"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "AudioVideo"
    },
    "protocols": [
      {
        "name": "异起看",
        "schemes": [
          "yiqikan"
        ]
      }
    ]
  },
  "dependencies": {
    "@yiqikan/shared": "workspace:*",
    "adm-zip": "^0.6.1",
    "electron-updater": "^6.8.3"
  },
  "devDependencies": {
    "@types/adm-zip": "^0.5.8",
    "@types/node": "^22.10.1",
    "electron": "^33.4.11",
    "electron-builder": "^26.8.1",
    "electron-vite": "^3.1.0",
    "typescript": "^5.7.2",
    "vite": "^5.4.11"
  }
}
