diff --git a/apple/RNCEmbeddedNavigationPolicy.h b/apple/RNCEmbeddedNavigationPolicy.h
new file mode 100644
index 0000000000000000000000000000000000000000..93fb37eeef26fed71bf9814d23921217de67dc80
--- /dev/null
+++ b/apple/RNCEmbeddedNavigationPolicy.h
@@ -0,0 +1,23 @@
+#import <Foundation/Foundation.h>
+#import <WebKit/WebKit.h>
+
+typedef NS_ENUM(NSInteger, RNCEmbeddedNavigationDecision) {
+  RNCEmbeddedNavigationAllow,
+  RNCEmbeddedNavigationLoadInternally,
+  RNCEmbeddedNavigationBlock,
+};
+
+// Yiqikan: a protocol policy, not a list of particular websites or apps.
+FOUNDATION_EXPORT BOOL RNCIsEmbeddedWebURL(NSURL *url);
+
+@interface RNCEmbeddedNavigationPolicy : NSObject
+@property (nonatomic, copy, readonly) NSString *blockedReason;
+- (RNCEmbeddedNavigationDecision)decisionForRequest:(NSURLRequest *)request
+                                       currentURL:(NSURL *)currentURL
+                                        sourceURL:(NSURL *)sourceURL
+                                    navigationType:(WKNavigationType)navigationType
+                                       isTopFrame:(BOOL)isTopFrame;
+- (void)recordAPIRequest:(NSURLRequest *)request;
+- (void)beginNavigation;
+- (void)reset;
+@end
diff --git a/apple/RNCEmbeddedNavigationPolicy.m b/apple/RNCEmbeddedNavigationPolicy.m
new file mode 100644
index 0000000000000000000000000000000000000000..c2de608b88a8bd9ee25fdc140238e649a77f7f13
--- /dev/null
+++ b/apple/RNCEmbeddedNavigationPolicy.m
@@ -0,0 +1,94 @@
+#import "RNCEmbeddedNavigationPolicy.h"
+
+BOOL RNCIsEmbeddedWebURL(NSURL *url)
+{
+  NSString *scheme = url.scheme.lowercaseString;
+  if ([scheme isEqualToString:@"http"] || [scheme isEqualToString:@"https"]) return url.host.length > 0;
+  if ([scheme isEqualToString:@"data"] || [scheme isEqualToString:@"blob"]) return YES;
+  if (![scheme isEqualToString:@"about"]) return NO;
+  NSString *resource = [[url.absoluteString substringFromIndex:6] stringByRemovingPercentEncoding];
+  NSString *page = [[resource componentsSeparatedByCharactersInSet:[NSCharacterSet characterSetWithCharactersInString:@"?#"]] firstObject];
+  return [page isEqualToString:@"blank"] || [page isEqualToString:@"srcdoc"];
+}
+
+@implementation RNCEmbeddedNavigationPolicy {
+  NSMutableArray<NSDictionary *> *_pendingReplays;
+  NSUInteger _replays;
+}
+
+- (void)reset
+{
+  [_pendingReplays removeAllObjects];
+  _replays = 0;
+  _blockedReason = nil;
+}
+
+- (void)beginNavigation
+{
+  // Source updates can race callbacks for an earlier API load. Keep its
+  // short-lived grant so a cancelled load is not replayed as a new page.
+  _replays = 0;
+  _blockedReason = nil;
+}
+
+- (void)recordAPIRequest:(NSURLRequest *)request
+{
+  if (!_pendingReplays) _pendingReplays = [NSMutableArray new];
+  if (_pendingReplays.count >= 64) [_pendingReplays removeObjectAtIndex:0];
+  [_pendingReplays addObject:@{@"request": [request copy], @"expires": @([NSDate timeIntervalSinceReferenceDate] + 5)}];
+}
+
+- (RNCEmbeddedNavigationDecision)decisionForRequest:(NSURLRequest *)request
+                                       currentURL:(NSURL *)currentURL
+                                        sourceURL:(NSURL *)sourceURL
+                                    navigationType:(WKNavigationType)navigationType
+                                       isTopFrame:(BOOL)isTopFrame
+{
+  _blockedReason = nil;
+  if (!RNCIsEmbeddedWebURL(request.URL)) {
+    _blockedReason = @"已阻止网页打开外部应用";
+    return RNCEmbeddedNavigationBlock;
+  }
+  NSString *scheme = request.URL.scheme.lowercaseString;
+  if (!isTopFrame || !([scheme isEqualToString:@"https"] || [scheme isEqualToString:@"http"])) {
+    return RNCEmbeddedNavigationAllow;
+  }
+  // Only the single native load we just scheduled may consume this allowance.
+  // Requests still pass the app's onShouldStartLoadWithRequest before this check.
+  NSTimeInterval now = [NSDate timeIntervalSinceReferenceDate];
+  for (NSInteger i = (NSInteger)_pendingReplays.count - 1; i >= 0; i--) {
+    NSDictionary *grant = _pendingReplays[(NSUInteger)i];
+    if ([grant[@"expires"] doubleValue] < now) {
+      [_pendingReplays removeObjectAtIndex:(NSUInteger)i];
+      continue;
+    }
+    NSURLRequest *pending = grant[@"request"];
+    if (navigationType == WKNavigationTypeOther && [request.URL isEqual:pending.URL]
+        && [(request.HTTPMethod ?: @"GET") isEqualToString:(pending.HTTPMethod ?: @"GET")]) {
+      [_pendingReplays removeObjectAtIndex:(NSUInteger)i];
+      return RNCEmbeddedNavigationAllow;
+    }
+  }
+  if (navigationType != WKNavigationTypeOther) _replays = 0;
+  // WebKit does not open Universal Links for back/forward navigation.
+  if (navigationType == WKNavigationTypeBackForward) return RNCEmbeddedNavigationAllow;
+  NSString *host = request.URL.host.lowercaseString;
+  BOOL sameCurrentHost = [host isEqualToString:currentURL.host.lowercaseString];
+  BOOL sameSourceHost = !sourceURL.host.length || [host isEqualToString:sourceURL.host.lowercaseString];
+  if (sameCurrentHost && sameSourceHost) return RNCEmbeddedNavigationAllow;
+
+  // Never turn a POST/upload into a GET or silently submit an empty body.
+  NSString *method = (request.HTTPMethod ?: @"GET").uppercaseString;
+  if (![method isEqualToString:@"GET"] && ![method isEqualToString:@"HEAD"]
+      && !request.HTTPBody && !request.HTTPBodyStream) {
+    _blockedReason = @"网页跨站提交缺少完整请求内容，已阻止提交，请返回网站重试";
+    return RNCEmbeddedNavigationBlock;
+  }
+  if (++_replays > 20) {
+    _blockedReason = @"网页跨站跳转次数过多，已停止加载";
+    return RNCEmbeddedNavigationBlock;
+  }
+  [self recordAPIRequest:request];
+  return RNCEmbeddedNavigationLoadInternally;
+}
+@end
